# =============================================================================
# Hardening Sprint 3 — repo security
#
# NEVER commit real secrets. .env files of any kind are blocked except for the
# tracked `.env.example` placeholders. If a secret is committed by mistake:
#   1. Rotate it immediately in the upstream provider (Supabase, Stripe, ...).
#   2. Run `git rm --cached <file>` and force-rotate everywhere the leak landed.
#   3. Document the incident.
# =============================================================================

# Environment
.env
.env.*
!.env.example

# Node / Next
node_modules/
.next/
.vercel/
dist/
out/
coverage/

# Logs / debug output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.cache/

# Editors / IDE
.vscode/
.idea/

# Supabase CLI scratch
supabase/.temp/
supabase/.branches/
supabase/.env

# OS
.DS_Store
Thumbs.db

# Supabase CLI
supabase/.temp/

# Sprint 4 TASK 12: never commit real env files. The only env file
# that may ship in the repo is a placeholder `.env.example`.
.env
.env.*
!.env.example
!**/.env.example

# Claude Code session data (local settings, agent worktrees)
.claude/

# Unity WebGL build output (PR #194). A build artifact — never committed.
# A future local/dev build may be placed here (served at /unity/penalty444/)
# for manual testing only. Only the penalty444/ output folder is ignored;
# apps/web/public/unity/README.md is intentionally kept tracked.
apps/web/public/unity/penalty444/
