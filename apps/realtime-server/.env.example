# =============================================================================
# 444 ARENA — realtime server .env example  (Railway deployment reference)
#
# Copy to `.env` and fill in real values. NEVER commit the populated .env.
#
# REQUIRED for controlled beta:
#   - SOCKET_JWT_ENFORCE=true  — sockets without a valid Supabase JWT cannot
#     act as any player. Must be true before sharing with testers.
#   - ALLOWED_ORIGINS           — production CORS allowlist. Fatal if empty
#     in production. Set to your Vercel deployment URL(s).
#   - SUPABASE_SERVICE_ROLE_KEY — server-only. Never expose to clients.
#
# ECONOMY during Free Play beta:
#   ECONOMY_ENABLED=false keeps wallet/escrow/settlement fully disabled.
#   Do not enable until the pre-real-money checklist is complete.
# =============================================================================

# Supabase (server-side, service role only — never expose to clients)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Must match REALTIME_INTERNAL_SECRET in apps/web/.env.local. Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REALTIME_INTERNAL_SECRET=

# CORS — comma-separated list of allowed origins (production).
# Example: https://your-app.vercel.app,https://your-custom-domain.com
# Fatal if empty when NODE_ENV=production. In dev this is not required.
ALLOWED_ORIGINS=

# Hardening Sprint 2/4/6 — socket JWT enforcement.
#
# REQUIRED `true` for staging, production, and Phase 9 beta soak: sockets
# without a valid Supabase access token cannot register, queue ranked,
# join/create rooms, make public offers, or act in a match as another
# player. Authenticated clients already send `accessToken` on connect (see
# apps/web/src/lib/socket/client.ts), so this should not break normal
# Quick Match, Private Room, Public Offer, or Tournament flows.
#
# `false` is LOCAL/DEV ONLY — for local development against a realtime
# server with no Supabase service-role key configured, set this to `false`
# so anonymous/guest sockets keep working (JWT checks become soft/log-only).
# Never set `false` in staging or production. See docs/socket-auth-plan.md
# for the enforcement rollout history.
SOCKET_JWT_ENFORCE=true

# Phase 10/11/12 — economy.
# Test mode allows the in-memory ledger to run without affecting real
# wallets. Real money MUST stay false until the pre-real-money
# checklist is fully green. ECONOMY_REAL_MONEY_ENABLED=true requires
# SOCKET_JWT_ENFORCE=true (the server fails to start otherwise).
ECONOMY_ENABLED=false
ECONOMY_TEST_MODE=false
ECONOMY_REAL_MONEY_ENABLED=false

# Phase 12 — reconciliation worker. Off by default.
ECONOMY_RECONCILIATION_ENABLED=false
