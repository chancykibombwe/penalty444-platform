# Realtime server local config — copy to `.env` and fill in.
# `.env` is git-ignored; do not commit real values.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Must match REALTIME_INTERNAL_SECRET in apps/web/.env.local
REALTIME_INTERNAL_SECRET=

# Hardening Sprint 2 / Phase 12. Flip to `true` before enabling real money.
SOCKET_JWT_ENFORCE=false

# Economy feature flags. Keep all `false` for free-play environments.
ECONOMY_ENABLED=false
ECONOMY_TEST_MODE=false
ECONOMY_REAL_MONEY_ENABLED=false
ECONOMY_RECONCILIATION_ENABLED=false
