# Realtime server local config — copy to `.env` and fill in.
# `.env` is git-ignored; do not commit real values.

# Realtime server environment placeholders.
# Copy to .env and fill in real values. NEVER commit the populated .env.

# Supabase (server-side, service role)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Must match REALTIME_INTERNAL_SECRET in apps/web/.env.local. Generate
# with: PowerShell `-join ((1..32 | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) }))`
REALTIME_INTERNAL_SECRET=

# Hardening Sprint 2/4/6 — socket JWT enforcement.
#
# Production-safe default is `true`: sockets without a valid Supabase
# access token cannot register, queue ranked, join/create rooms, make
# public offers, or act in a match as another player. Authenticated
# clients already send `accessToken` on connect (see
# apps/web/src/lib/socket/client.ts), so this should not break normal
# Quick Match, Private Room, Public Offer, or Tournament flows.
#
# For local development against a realtime server with no Supabase
# service-role key configured, set this to `false` so anonymous/guest
# sockets keep working (JWT checks become soft/log-only).
SOCKET_JWT_ENFORCE=true

# Phase 10/11/12 — economy.
# Test mode allows the in-memory ledger to run without affecting real
# wallets. Real money MUST stay false until the pre-real-money
# checklist is fully green. ECONOMY_REAL_MONEY_ENABLED=true requires
# SOCKET_JWT_ENFORCE=true (the server fails to start otherwise).
ECONOMY_ENABLED=false
ECONOMY_TEST_MODE=false
ECONOMY_REAL_MONEY_ENABLED=false

# Phase 12 — reconciliation worker. Off by default.
ECONOMY_RECONCILIATION_ENABLED=false
