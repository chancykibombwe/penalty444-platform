# =============================================================================
# Penalty444 — root .env example.
#
# Copy this to a NEW file and fill in your local values:
#   apps/web/.env.local              (Next.js)
#   apps/realtime-server/.env        (realtime server)
#
# NEVER commit real values. The `.gitignore` blocks every `.env*` except this
# example. If a real secret slips in, ROTATE it in Supabase / your provider
# before doing anything else.
#
# Hardening Sprint 3 reference. See:
#   - docs/database-security.md
#   - docs/supabase-security-checklist.md
#   - docs/pre-real-money-checklist.md
# =============================================================================

# ----------------------------------------------------------------------------
# Supabase — public (browser + server)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ----------------------------------------------------------------------------
# Supabase — server-only. NEVER expose to the browser.
#   * Required by /apps/realtime-server (escrow, settlement, audit writes)
#   * Required by /apps/web server routes (tournament admin, internal API)
# ----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------------
# Realtime ↔ web bridge.
#   `REALTIME_INTERNAL_SECRET` MUST match between web and realtime-server.
#   Used to authenticate `/internal/*` traffic between the two services.
# ----------------------------------------------------------------------------
# Browser Socket.IO (set on Vercel). Production example:
# https://penalty444-platform-production.up.railway.app
NEXT_PUBLIC_REALTIME_URL=
REALTIME_INTERNAL_URL=http://localhost:4000
REALTIME_INTERNAL_SECRET=

# ----------------------------------------------------------------------------
# Cron / scheduled jobs (server-only).
#   Used by `/api/internal/tournaments/tick`. Send as
#   `Authorization: Bearer <CRON_SECRET>`.
# ----------------------------------------------------------------------------
CRON_SECRET=

# ----------------------------------------------------------------------------
# Tournament scheduled auto-start (Phase 8B beta policy).
#   Beta policy: tournaments are manual host-controlled start only.
#   When NOT "true", `/api/internal/tournaments/tick` skips
#   `startTournament({ source: "scheduled" })` entirely — registration/
#   check-in tournaments will NOT auto-start, even if `starts_at` has
#   passed. Cleanup/no-show processing still runs regardless.
#   Manual host-triggered start (`source: "manual"`) is never gated by
#   this flag. Leave unset/false until a reliable frequent scheduler and
#   an explicit product decision to enable auto-start are in place.
# ----------------------------------------------------------------------------
TOURNAMENT_AUTO_START_ENABLED=false

# ----------------------------------------------------------------------------
# Socket auth (Hardening Sprint 2 — TASK 2).
#   Keep `false` until every web client always sends the access token.
#   Phase 12 launch blocker: real money MUST NOT enable until this is `true`.
# ----------------------------------------------------------------------------
SOCKET_JWT_ENFORCE=false

# ----------------------------------------------------------------------------
# Economy feature flags (Phases 10–12). Default everything OFF.
# ----------------------------------------------------------------------------
ECONOMY_ENABLED=false
ECONOMY_TEST_MODE=false
ECONOMY_REAL_MONEY_ENABLED=false
ECONOMY_RECONCILIATION_ENABLED=false

# Browser-visible economy mode label rendered by the wallet UI.
# One of: off | test | live. Keep aligned with the server-side flags.
NEXT_PUBLIC_ECONOMY_MODE=off
